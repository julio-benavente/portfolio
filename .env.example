# Copy this file to .env.local (ignored by git) and fill in the values.

# Resend API key, from https://resend.com/api-keys
RESEND_API_KEY=

# Optional. Defaults to Resend's test sender "Julio Benavente <onboarding@resend.dev>",
# which only delivers to the email you signed up to Resend with.
# After verifying juliobenavente.com in Resend, use "Julio Benavente <hello@juliobenavente.com>".
RESEND_FROM=
